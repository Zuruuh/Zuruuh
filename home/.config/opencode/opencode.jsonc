{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@dietrichgebert/ponytail"
  ],
  "shell": "/run/current-system/sw/bin/bash",
  "mcp": {
    "Jira": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp"
    },
    "Guru": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.api.getguru.com/mcp",
      "oauth": {}
    },
    "Home Assistant": {
      "type": "remote",
      "enabled": false,
      "url": "https://home.yziadi.fyi/api/mcp",
      "oauth": {
        "clientId": "http://127.0.0.1:19876"
      }
    }
  },
  "permission": {
    "bash": {
      "git *": "deny"
    }
  }
}
